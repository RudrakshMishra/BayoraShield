#!/usr/bin/env python3
"""Verify a JSON BayoraShield ledger without modifying it."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from services.common.ledger import verify_chain  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify a BayoraShield hash chain")
    parser.add_argument("--ledger", required=True, type=Path)
    args = parser.parse_args()
    entries = json.loads(args.ledger.read_text(encoding="utf-8"))
    ok, bad_seq, reason = verify_chain(entries)
    result = {"ok": ok, "checked": len(entries), "first_bad_seq": bad_seq, "reason": reason}
    print(json.dumps(result, sort_keys=True))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
