#!/usr/bin/env python3
"""Write a deterministic metadata-only ledger fixture for local verification."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from services.common.ledger import GENESIS_HASH, make_entry  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    first = make_entry(1, GENESIS_HASH, cell="broker", action="bootstrap")
    entries = [first, make_entry(2, first["entry_hash"], cell="ledger", action="append")]
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(entries, indent=2) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
